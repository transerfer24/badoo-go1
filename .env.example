APP_ENV=dev
ADDR=:8080
# База проекта на хостинге (dreampro_wbadoo) — та же, что и у боевого сервера. Локальная SQLite для опытов:
# DB_DSN=file:runtime/app.db
DB_DSN=dreampro_whales:PASSWORD@tcp(dreampro.mysql.tools:3306)/dreampro_wbadoo?charset=utf8mb4&parseTime=true
# Ключ сессий/CSRF/remember-me — минимум 32 случайных символа; "новый,старый" для ротации
COOKIE_KEY=CHANGE_ME
# Метрики: Authorization: Bearer <token> на /metrics
METRICS_TOKEN=CHANGE_ME
# Вход только через Neuronet (как wealthbook.app/signin): номер сервиса и секрет из ts_services в Neuronet.
# Без них вход не работает — своей регистрации и паролей у Amura нет.
NEURONET_URL=https://neuronet.app/apisignin
NEURONET_SERVICE=
NEURONET_SECRET=
# Push через Expo
PUSH=1
#EXPO_ACCESS_TOKEN=
# Фото: общий бакет Amazon S3 проектов, у Amura на Go1 своя папка (S3_PREFIX); без S3_KEY — локально в web/uploads
#S3_BUCKET=
#S3_KEY=
#S3_SECRET=
#S3_REGION=eu-central-1
#S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_PREFIX=badoo/prod/
# Режимы: AMURA_DEV=1 — верификация сразу, Premium без оплаты; AMURA_CHAT_VERIFY=1 — чат только подтверждённым
AMURA_DEV=1
AMURA_CHAT_VERIFY=0
MAIL_FROM=noreply@badoo.whales.team
#SMTP_HOST=
#SMTP_USER=
#SMTP_PASS=
#REDIS_URL=
#SENTRY_DSN=
