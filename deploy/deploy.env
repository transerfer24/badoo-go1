# Куда выкладывать badoo — не секреты, файл в git. Секреты (SSH-ключ, токен к ядру) — в GitHub → Settings → Secrets.
# Один раз на хостинге: каталог, .env, keepalive в crontab — см. docs/release.md ядра Go1.

DEPLOY_SSH=dreampro                              # алиас из ~/.ssh/config (на Mac); в GitHub Actions создаётся сам
DEPLOY_HOSTNAME=dreampro.ftp.tools               # сервер SSH
DEPLOY_USER=dreampro                             # пользователь хостинга
DEPLOY_DIR=/home/dreampro/whales.team/badoo/app  # каталог приложения на сервере (рядом с whales.team/go1)
HEALTH_URL=https://badoo.whales.team/healthz  # проверка после выкладки; не ответил — откат
