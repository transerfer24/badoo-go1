# /home/dreampro/whales.team/badoo/app/.env — секреты на хостинге (chmod 600). Копируется один раз (deploy/README.md).
APP_ENV=prod
# Адрес, куда хостинг проксирует https://badoo.whales.team (панель → сайт → «Проксирование HTTP-трафика
# в приложение»). у go1.whales.team — 127.1.9.172:3000, у badoo — 127.1.10.226:3000 (из панели).
ADDR=127.1.10.226:3000
TRUST_PROXY=1
BASE_URL=https://badoo.whales.team
DB_DSN=dreampro_whales:CHANGE_ME_DB_PASSWORD@tcp(localhost:3306)/dreampro_wbadoo?charset=utf8mb4&parseTime=true
COOKIE_KEY=CHANGE_ME
METRICS_TOKEN=CHANGE_ME
NEURONET_URL=https://neuronet.app/apisignin
NEURONET_SERVICE=CHANGE_ME
NEURONET_SECRET=CHANGE_ME
PUSH=1
EXPO_ACCESS_TOKEN=
S3_BUCKET=CHANGE_ME
S3_KEY=CHANGE_ME
S3_SECRET=CHANGE_ME
S3_REGION=eu-central-1
S3_PREFIX=badoo/prod/
AMURA_DEV=1
AMURA_CHAT_VERIFY=0
MAIL_FROM=noreply@badoo.whales.team
